# Copy to .env and fill as needed. App runs offline without keys.

# GBIF — public API; no key required for modest rates. Optional account:
# GBIF_USER=
# GBIF_PWD=
# GBIF_EMAIL=you@example.com

# IUCN Red List API v4 — NEVER invent statuses.
# Free research/education signup: https://api.iucnredlist.org/users/sign_up
# Manage token: https://api.iucnredlist.org/users/edit
# Docs: https://api.iucnredlist.org/api-docs/index.html
# Terms: https://www.iucnredlist.org/terms/terms-of-use
# If unset, pipeline writes iucn_status=not_queried and leaves category blank.
# IUCN is a SEPARATE dossier field — not an HPI input.
IUCN_API_TOKEN=

# Optional OpenAI for vernacular→scientific helper (OFF by default)
ENABLE_LLM_NAMES=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Streamlit
# STREAMLIT_SERVER_HEADLESS=true
